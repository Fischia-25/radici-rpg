<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            stylesheets="@giardino.css"
            fx:controller="it.unicam.cs.mpgc.rpg130722.ui.controllers.GiardinoController">

    <top>
        <VBox styleClass="intestazione">
            <Label text="Il tuo giardino" styleClass="titolo" />
            <Label fx:id="statoGiocatore" styleClass="stato-giocatore"
                   text="Livello 1 — Energia: 10/10 — Esperienza: 0" />
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-griglia">
            <GridPane fx:id="grigliaPiante" hgap="12" vgap="12"
                      styleClass="griglia-piante" />
        </ScrollPane>
    </center>

    <bottom>
        <VBox spacing="10" styleClass="pannello-azioni">
            <Label fx:id="statoSelezionato" text="Seleziona una pianta" styleClass="etichetta-selezione" />
            <HBox spacing="10">
                <Button text="Annaffia" onAction="#onAnnaffia" />
                <Button text="Trascura" onAction="#onTrascura" />
                <Button text="Purifica" onAction="#onPurifica" />
            </HBox>
            <HBox spacing="10">
                <Button text="Nuovo giorno" onAction="#onNuovoGiorno" />
                <Button text="Salva" onAction="#onSalva" />
            </HBox>
        </VBox>
    </bottom>

</BorderPane>